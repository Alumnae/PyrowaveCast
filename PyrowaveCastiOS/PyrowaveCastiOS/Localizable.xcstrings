    "server.permission_guide_step1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie unten auf „Systemeinstellungen öffnen“, um Systemeinstellungen → Datenschutz & Sicherheit → Bildschirm- & Systemaudioaufnahme zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click \"Open System Settings\" below to open System Settings → Privacy & Security → Screen & System Audio Recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en «Abrir Ajustes del Sistema» abajo para abrir Ajustes del Sistema → Privacidad y seguridad → Grabación de pantalla y audio del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur « Ouvrir les Réglages Système » ci-dessous pour ouvrir Réglages Système → Confidentialité et sécurité → Enregistrement de l’écran et de l’audio système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca \"Apri Impostazioni di Sistema\" qui sotto: si aprirà direttamente Impostazioni di Sistema → Privacy e sicurezza → Registrazione schermo e audio di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下の「システム設定を開く」をクリックすると、「システム設定 → プライバシーとセキュリティ → 画面収録とシステムオーディオ録音」が開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击下方的“打开系统设置”：将直接打开“系统设置 → 隐私与安全性 → 录屏与系统录音”。"
          }
        }
      }
    },
    "server.permission_guide_step2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn „PyrowaveCast“ bereits aufgeführt ist, aktivieren Sie den Schalter. Andernfalls klicken Sie unten links auf „+“, wählen Sie PyrowaveCast.app aus (nutzen Sie „Im Finder zeigen“) und klicken Sie auf „Öffnen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If \"PyrowaveCast\" is already listed, enable its toggle. If it is NOT listed, click the \"+\" button at the bottom left, select PyrowaveCast.app (use \"Show in Finder\" to locate it quickly), and click \"Open\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si «PyrowaveCast» ya aparece en la lista, activa su interruptor. Si NO aparece, haz clic en el botón «+» abajo a la izquierda, selecciona PyrowaveCast.app (usa «Mostrar en el Finder») y haz clic en «Abrir»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si « PyrowaveCast » figure déjà dans la liste, activez son interrupteur. Sinon, cliquez sur le bouton « + » en bas à gauche, sélectionnez PyrowaveCast.app (utilisez « Afficher dans le Finder ») et cliquez sur « Ouvrir »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se \"PyrowaveCast\" è già nella lista, attiva l’interruttore accanto al nome. Se NON compare nella lista, clicca il pulsante \"+\" in basso a sinistra, seleziona PyrowaveCast.app (usa \"Mostra nel Finder\" per trovarla subito) e clicca \"Apri\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「PyrowaveCast」が一覧にある場合はスイッチをオンにします。一覧にない場合は左下の「+」をクリックし、PyrowaveCast.app（「Finderで表示」ですぐに見つかります）を選択して「開く」をクリックします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果列表中已有“PyrowaveCast”，请打开其开关。如果不在列表中，请点击左下角的“+”按钮，选择 PyrowaveCast.app（可使用“在访达中显示”快速定位）并点击“打开”。"
          }
        }
      }
    },
    "server.permission_guide_step3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihr Mac-Passwort ein oder verwenden Sie Touch ID, wenn macOS Sie dazu auffordert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your Mac password or use Touch ID when prompted by macOS."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce la contraseña de tu Mac o usa Touch ID cuando macOS lo solicite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le mot de passe de votre Mac ou utilisez Touch ID lorsque macOS vous le demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la password del Mac oppure usa Touch ID quando richiesto da macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSに求められたら、Macのパスワードを入力するかTouch IDを使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 macOS 提示时，输入您的 Mac 密码或使用触控 ID。"
          }
        }
      }
    },
    "server.permission_guide_step4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn macOS „Beenden & erneut öffnen“ anzeigt, klicken Sie darauf (oder starten Sie PyrowaveCast manuell neu). Klicken Sie danach auf „Überprüfen“ und „Starten“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When macOS prompts \"Quit & Reopen\", click \"Quit & Reopen\" (or restart PyrowaveCast manually). Then click \"Verify\" and \"Start\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando macOS pregunte «Salir y volver a abrir», haz clic en ello (o reinicia PyrowaveCast manualmente). Luego haz clic en «Verificar» e «Iniciar»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque macOS affiche « Quitter et rouvrir », cliquez dessus (ou relancez PyrowaveCast manuellement). Cliquez ensuite sur « Vérifier » puis « Démarrer »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando macOS chiede \"Esci e riapri\", clicca \"Esci e riapri\" (oppure chiudi e riapri PyrowaveCast manualmente). Poi clicca \"Verifica\" e \"Avvia\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOSに「終了して再度開く」と表示されたらクリックします（または手動で再起動します）。その後「確認」と「開始」をクリックしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 macOS 提示“退出并重新打开”时，点击它（或手动重启 PyrowaveCast）。然后点击“验证”和“启动”。"
          }
        }
      }
    },
