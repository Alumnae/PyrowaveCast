    "server.help.card": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Animiertes Testbild, Bild und Endlosvideo bieten dieselben Testquellen wie der Mac-Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animated test card, image, and looped video preserve the Mac server's test-source modes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carta de ajuste animada, la imagen y el vídeo en bucle conservan los modos de prueba del servidor Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mire animée, l’image et la vidéo en boucle conservent les modes de test du serveur Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheda test animata, immagine e video in loop mantengono le modalità sorgente di test del server Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アニメーションテストカード、画像、ループ動画はMacサーバーのテストソースモードと同様に動作します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动态测试卡、图片与循环视频模式与 Mac 服务器的测试源模式完全一致。"
          }
        }
      }
    },
    "server.help.image": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Bild wird in die App-Sandbox kopiert und mit PyrowaveCast-Codierung gestreamt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected image is copied into the app sandbox and streamed with PyrowaveCast encoding."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen seleccionada se copia en el entorno aislado de la app y se transmite con codificación PyrowaveCast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’image sélectionnée est copiée dans le bac à sable de l’app et diffusée avec l’encodage PyrowaveCast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’immagine selezionata viene copiata nella sandbox dell’app e trasmessa con codifica PyrowaveCast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択された画像はアプリのサンドボックスにコピーされ、PyrowaveCastエンコードで配信されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选图片将复制到应用沙盒并通过 PyrowaveCast 编码进行串流。"
          }
        }
      }
    },
    "server.help.screen_ios27": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die System-Bildschirmfreigabe nutzt die iOS 27 ScreenCaptureKit-Auswahl. Bestätigen Sie den Systemdialog."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full system screen sharing uses the iOS 27 ScreenCaptureKit picker. Confirm the system prompt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El uso compartido de pantalla del sistema usa el selector ScreenCaptureKit de iOS 27. Confirma el aviso del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage d’écran système utilise le sélecteur ScreenCaptureKit d’iOS 27. Confirmez l’invite système."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La condivisione schermo di sistema usa il selettore ScreenCaptureKit di iOS 27. Conferma il prompt di sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム画面共有はiOS 27のScreenCaptureKitピッカーを使用します。システムプロンプトを確認してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统屏幕共享使用 iOS 27 ScreenCaptureKit 选择器，请在系统弹窗中确认。"
          }
        }
      }
    },
    "server.help.screen_older_ios": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "System-Bildschirmfreigabe erfordert iOS 27 oder neuer. Nutzen Sie Testbild, Bild oder Video auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System screen sharing requires iOS 27 or later. Use a test card, image, or video on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir la pantalla del sistema requiere iOS 27 o posterior. Usa carta de ajuste, imagen o vídeo en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage d’écran système nécessite iOS 27 ou ultérieur. Utilisez une mire, une image ou une vidéo sur cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La condivisione schermo di sistema richiede iOS 27 o successivo. Usa scheda test, immagine o video su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム画面共有にはiOS 27以降が必要です。このデバイスではテストカード、画像、またはビデオを使用してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统屏幕共享需要 iOS 27 或更高版本。请在此设备上使用测试卡、图片或视频模式。"
          }
        }
      }
    },
    "server.help.video": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgewählte Video wird in die App-Sandbox kopiert und in Endlosschleife als Stream-Quelle genutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected video is copied into the app sandbox and looped as the stream source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vídeo seleccionado se copia en el entorno aislado de la app y se reproduce en bucle como fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vidéo sélectionnée est copiée dans le bac à sable de l’app et lue en boucle comme source du flux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il video selezionato viene copiato nella sandbox dell’app e riprodotto in loop come sorgente stream."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたビデオはアプリのサンドボックスにコピーされ、ストリームソースとしてループ再生されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选视频将复制到应用沙盒并循环播放作为串流源。"
          }
        }
      }
    },
    "server.log.permission_missing_warning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnung: Berechtigung „Bildschirmaufnahme“ ist nicht aktiv. Folgen Sie der Anleitung unter Systemeinstellungen → Datenschutz & Sicherheit und starten Sie PyrowaveCast neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warning: \"Screen Recording\" permission is not active. Follow the step-by-step guide in System Settings → Privacy & Security and restart PyrowaveCast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atención: el permiso «Grabación de pantalla» no está activo. Sigue la guía en Ajustes del Sistema → Privacidad y seguridad y reinicia PyrowaveCast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention : l’autorisation « Enregistrement de l’écran » n’est pas active. Suivez le guide dans Réglages Système → Confidentialité et sécurité puis relancez PyrowaveCast."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione: permesso \"Registrazione schermo\" non attivo. Segui la guida passo-passo in Impostazioni di Sistema → Privacy e sicurezza e riavvia PyrowaveCast."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告: 「画面収録」の権限が有効ではありません。「システム設定 → プライバシーとセキュリティ」のガイドに従って設定し、PyrowaveCastを再起動してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "警告：“屏幕录制”权限未开启。请按照“系统设置 → 隐私与安全性”中的分步指南操作并重启 PyrowaveCast。"
          }
        }
      }
    },
